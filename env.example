# --- OpenAI ---
# Clave de OpenAI (Realtime). Obligatoria.
OPENAI_API_KEY=

# --- API de la tienda (usuario de servicio «Norivy») ---
# Obligatorias. Las credenciales viven SOLO en el backend (nunca llegan a la pantalla).
# Para desarrollo sin el sistema real: `python -m norivy_kiosk.mock_store` (puerto 8780).
NORIVY_KIOSK_STORE_URL=http://127.0.0.1:8780
NORIVY_KIOSK_STORE_USER=norivy@tienda.local
NORIVY_KIOSK_STORE_PASSWORD=norivy123

# --- Identidad ---
NORIVY_KIOSK_STORE_NAME=nuestra tienda
NORIVY_KIOSK_CHARACTER_NAME=Norivy

# --- Red local del backend (Electron) ---
NORIVY_KIOSK_HOST=127.0.0.1
NORIVY_KIOSK_PORT=8773

# --- Voz / audio (calibrar en el local con el micrófono real) ---
NORIVY_KIOSK_MODEL=gpt-realtime-2.1
NORIVY_KIOSK_VOICE=coral
NORIVY_KIOSK_OUTPUT_SPEED=1.05
# Vacío = micrófono por defecto del sistema (índice numérico o nombre).
NORIVY_KIOSK_MIC_DEVICE=
# Sube el umbral (0-1) si responde al ruido de la tienda; bájalo si no oye al cliente.
NORIVY_KIOSK_VAD_THRESHOLD=0.6
# near_field (cliente pegado al mic) | far_field (mic lejano) | off
NORIVY_KIOSK_NOISE_REDUCTION=far_field
